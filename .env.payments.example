# Merge these placeholders into your private .env. Never commit actual credentials.
PAYPAL_MODE=sandbox
PAYPAL_PUBLIC_BASE_URL=https://your-public-https-host.example
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_PREMIUM_PLAN_ID=

# SMTP is required for password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
